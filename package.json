{
  "name": "bruce-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts && node scripts/build-sw.mjs",
    "build:relay": "esbuild apps/relay/src/index.ts --bundle --format=esm --platform=neutral --external:cloudflare:workers --outfile=apps/relay/dist/worker.js",
    "typecheck": "tsc --noEmit && tsc -p apps/relay/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run build:relay",
    "test:relay": "npm run build:relay && node tests/relay.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.4.0",
    "cf": "latest",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.2.0",
    "miniflare": "^5.20261104.0-beta",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "ws": "^8.18.0"
  }
}
